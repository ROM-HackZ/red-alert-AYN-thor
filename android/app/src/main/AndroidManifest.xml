<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <application android:label="Red Alert - Thor" android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen" android:allowBackup="false" android:extractNativeLibs="true">
        <activity android:name=".LauncherActivity" android:exported="true" android:screenOrientation="landscape">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity>
        <activity android:name=".ThorActivity" android:exported="false" android:screenOrientation="landscape" android:launchMode="singleTask" android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode" />
    </application>
</manifest>
